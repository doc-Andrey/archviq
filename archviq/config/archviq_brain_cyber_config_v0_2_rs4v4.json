  "parameter_definitions": {
    "GAIN": {
      "label": "general signal gain / excitability calibration",
      "mode": "directional",
      "family": "BASE",
      "positive_meaning": "higher gain / stronger response to perturbation",
      "negative_meaning": "lower gain / weaker response to perturbation"
    },
    "NOISE_SENSITIVITY": {
      "label": "sensitivity to noisy/irregular input",
      "mode": "pressure_only",
      "family": "BASE",
      "positive_meaning": "direction not frozen in v0.2",
      "negative_meaning": "direction not frozen in v0.2"
    },
    "RECOVERY_BASELINE": {
      "label": "baseline return/recovery tendency",
      "mode": "directional",
      "family": "RECOVERY",
      "positive_meaning": "faster return after perturbation",
      "negative_meaning": "slower return / prolonged carry-over"
    },
    "THETA_W": {
      "label": "admission threshold theta_W",
      "mode": "directional",
      "family": "W",
      "runtime_baseline": 0.5,
      "positive_meaning": "higher admission threshold",
      "negative_meaning": "lower admission threshold"
    },
    "THETA_C": {
      "label": "threshold for request of Reality checking theta_C",
      "mode": "directional",
      "family": "W",
      "runtime_baseline": 0.75,
      "positive_meaning": "more evidence/coherence before Reality request",
      "negative_meaning": "earlier Reality request"
    },
    "TAU_INTEGRATION": {
      "label": "temporal integration constant",
      "mode": "directional",
      "family": "W",
      "positive_meaning": "longer temporal integration / longer accumulation",
      "negative_meaning": "shorter temporal integration / faster turnover"
    },
    "THETA_NU_TIME": {
      "label": "temporal naturalness/regularity threshold component of nu",
      "mode": "pressure_only",
      "family": "NU",
      "runtime_baseline": 0.6,
      "positive_meaning": "direction not frozen in v0.2",
      "negative_meaning": "direction not frozen in v0.2"
    },
    "THETA_NU_CROSS": {
      "label": "cross-source common-cause/independence threshold component of nu",
      "mode": "pressure_only",
      "family": "NU",
      "runtime_baseline": 0.6,
      "positive_meaning": "direction not frozen in v0.2",
      "negative_meaning": "direction not frozen in v0.2"
    },
    "THETA_NU_PROVENANCE": {
      "label": "provenance/self-generated evidence threshold component of nu",
      "mode": "pressure_only",
      "family": "NU",
      "runtime_baseline": 0.6,
      "positive_meaning": "direction not frozen in v0.2",
      "negative_meaning": "direction not frozen in v0.2"
    },
    "M_C": {
      "label": "minimum independent-source requirement M_C",
      "mode": "pressure_only",
      "family": "NU",
      "runtime_baseline": 2,
      "positive_meaning": "direction not frozen in v0.2",
      "negative_meaning": "direction not frozen in v0.2"
    },
    "COMPRESSION_STRENGTH": {
      "label": "degree of recurrent dimensional compression while retaining provenance",
      "mode": "directional",
      "family": "NU",
      "positive_meaning": "stronger compression / higher abstraction tendency",
      "negative_meaning": "weaker compression / more detail retained per level"
    },
    "D_C": {
      "label": "consecutive-PASS consolidation threshold D_C",
      "mode": "directional",
      "family": "D",
      "runtime_baseline": 10,
      "positive_meaning": "more persistence required before consolidation",
      "negative_meaning": "less persistence required before consolidation"
    },
    "PERSISTENCE": {
      "label": "state persistence / HOLD tendency",
      "mode": "directional",
      "family": "D",
      "positive_meaning": "stronger state persistence",
      "negative_meaning": "greater lability / weaker hold"
    },
    "HOLD_STABILITY": {
      "label": "stability of an already selected processing state",
      "mode": "directional",
      "family": "D",
      "positive_meaning": "more stable HOLD state",
      "negative_meaning": "easier spontaneous state turnover"
    },
    "THETA_D": {
      "label": "decision threshold",
      "mode": "directional",
      "family": "D",
      "positive_meaning": "more accumulated evidence required to commit decision",
      "negative_meaning": "less evidence required to commit decision"
    },
    "THETA_A": {
      "label": "action threshold",
      "mode": "pressure_only",
      "family": "D",
      "positive_meaning": "direction not frozen in v0.2",
      "negative_meaning": "direction not frozen in v0.2"
    },
    "SWITCH_THRESHOLD": {
      "label": "threshold for switching active state/configuration",
      "mode": "directional",
      "family": "D",
      "positive_meaning": "higher switch threshold",
      "negative_meaning": "lower switch threshold / easier switching"
    },
    "UPDATE_MAGNITUDE": {
      "label": "size of post-threshold update",
      "mode": "directional",
      "family": "U",
      "positive_meaning": "larger update once change occurs",
      "negative_meaning": "smaller incremental update"
    },
    "THETA_U": {
      "label": "model-update threshold",
      "mode": "directional",
      "family": "U",
      "positive_meaning": "more contradiction required before changing model",
      "negative_meaning": "model changes after less contradiction"
    },
    "HYSTERESIS_W": {
      "label": "history-dependence width for admission/gating",
      "mode": "directional",
      "family": "W",
      "positive_meaning": "wider admission hysteresis band",
      "negative_meaning": "narrower admission hysteresis band"
    },
    "HYSTERESIS_NU": {
      "label": "history-dependence width for nu/common-cause checks",
      "mode": "directional",
      "family": "NU",
      "positive_meaning": "wider nu hysteresis band",
      "negative_meaning": "narrower nu hysteresis band"
    },
    "HYSTERESIS_D": {
      "label": "history-dependence width for HOLD/decision/switch",
      "mode": "directional",
      "family": "D",
      "positive_meaning": "wider HOLD/switch hysteresis band",
      "negative_meaning": "narrower HOLD/switch hysteresis band"
    },
    "HYSTERESIS_U": {
      "label": "history-dependence width for model update",
      "mode": "directional",
      "family": "U",
      "positive_meaning": "wider model-update hysteresis band",
      "negative_meaning": "narrower model-update hysteresis band"
    },
    "K_ASYMMETRY": {
      "label": "K_down/K_up trust-update asymmetry calibration",
      "mode": "pressure_only",
      "family": "TRUST",
      "positive_meaning": "direction not frozen in v0.2",
      "negative_meaning": "direction not frozen in v0.2"
    },
    "SPAWN_THRESHOLD": {
      "label": "sensitivity/threshold of latent-model spawn",
      "mode": "pressure_only",
      "family": "U",
      "positive_meaning": "direction not frozen in v0.2",
      "negative_meaning": "direction not frozen in v0.2"
    },
    "REALITY_CALIBRATION": {
      "label": "developmental calibration pressure on Reality-monitoring machinery",
      "mode": "pressure_only",
      "family": "REALITY",
      "positive_meaning": "pressure only; no high/low interpretation",
      "negative_meaning": "pressure only; no high/low interpretation"
    },
    "U_ROUTING_CAPACITY": {
      "label": "capacity of error-target routing operator U",
      "mode": "pressure_only",
      "family": "U",
      "positive_meaning": "pressure only; no high/low interpretation",
      "negative_meaning": "pressure only; no high/low interpretation"
    },
    "GAMMA_CAPACITY": {
      "label": "offline sleep recalibration capacity Gamma",
      "mode": "pressure_only",
      "family": "GAMMA",
      "positive_meaning": "pressure only; no high/low interpretation",
      "negative_meaning": "pressure only; no high/low interpretation"
    },
    "ANCHOR_STABILITY": {
      "label": "stability of offline-promoted anchors",
      "mode": "directional",
      "family": "U",
      "positive_meaning": "more stable anchors once established",
      "negative_meaning": "anchors more readily revised"
    },
    "MEMORY_DUAL_TIMESCALE_CAPACITY": {
      "label": "capacity for fast Q_use and slow S_trace memory dynamics",
      "mode": "pressure_only",
      "family": "GAMMA",
      "positive_meaning": "pressure only; no high/low interpretation",
      "negative_meaning": "pressure only; no high/low interpretation"
    }
  },
